# opencode go: ключ из ~/.pi/agent/auth.json на локалке (поле key вида oc_sk_...)
OPENCODE_API_KEY=oc_sk_xxxxxxxxxxxxxxxxxxxxxxxx
OPENCODE_MODEL=muse-spark-1.3-contributor
OPENCODE_MODEL_FALLBACK=glm-5.3-flash

# Telegram bot (командный интерфейс админов)
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_USERNAME=lalsdjasdljkbot
ADMIN_IDS=7362888426,255229087

# Юзербот-коллектор (Telethon). Ключи необязательны — дефолт: Telegram Desktop
# API_ID=12345678
# API_HASH=xxxx....

SESSION_PATH=/data/session

# /get
GET_N=5
GET_MAX=10
GET_CANDIDATES=15
MEDIA_WAIT_S=120
LINK_GAP=5

# LLM-оптимизации
TRANSLATE_MODE=single   # single | batch (экспериментально)
LLM_TIMEOUT=90
LLM_MAX_OUTPUT=2000
LLM_RETRIES=2
LLM_PARALLEL=5

TZ=Europe/Berlin
