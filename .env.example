# opencode go: ключ из ~/.pi/agent/auth.json на локалке (поле key вида oc_sk_...)
OPENCODE_API_KEY=oc_sk_xxxxxxxxxxxxxxxxxxxxxxxx
OPENCODE_MODEL=muse-spark-1.3-contributor
OPENCODE_MODEL_FALLBACK=glm-5.3-flash

# Telegram bot (командный интерфейс админов)
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_USERNAME=lalsdjasdljkbot
ADMIN_IDS=7362888426,255229087

# Юзербот-коллектор (Telethon). Ключи необязательны — дефолт: Telegram Desktop
# API_ID=12345678
# API_HASH=xxxx....

SESSION_PATH=/data/session

# /get
GET_N=5
GET_MAX=20
GET_CANDIDATES=15
MEDIA_WAIT_S=120
LINK_GAP=5

# LLM-оптимизации
TRANSLATE_MODE=single   # single | batch (экспериментально)
LLM_TIMEOUT=90
LLM_MAX_OUTPUT=2000
LLM_RETRIES=2
LLM_PARALLEL=5

TZ=Europe/Berlin

# ---- фактчекинг ----
# off | shadow | on   (shadow: вердикт считается и пишется в БД, метка в пост не идёт)
FC_ENABLED=off
SEARX_URL=http://searxng:8080
# основной набор движков (объединяются за один запрос)
SEARX_ENGINES=bing,brave,mojeek
# локаль движков для агентского режима
SEARX_LANGUAGE=en
FC_CYCLES=2
FC_MAX_CLAIMS=6
FC_DEADLINE_S=120
FC_CALLS_PER_POST=12
FC_JUDGE_CONCURRENCY=4
FC_TOP_HITS=8
FC_SNIPPETS=4
FC_MAX_QUERIES=5
# вариант 2: переписывать пост под данные независимых (не государственных) источников
FC_FIX_FACTS=off
FC_FIX_MIN_CONF=0.7
# меньше источников — «недостаточно данных», метка не ставится
FC_MIN_COVERAGE=5
# сколько секунд /get ждёт готовности проверки
FC_WAIT_S=60
# ниже этого % корректности пост помечается тегом
FC_LOW_CORRECTNESS=0.3
# предохранитель расходов: вызовов LLM в сутки (0 = без лимита)
FC_DAILY_CALLS=600
# сколько дней хранить запуски/evidence/задачи фактчекинга
FC_RETENTION_DAYS=14
# модели: пусто -> OPENCODE_MODEL_FALLBACK (дешёвая)
FC_CLAIM_MODEL=
FC_JUDGE_MODEL=
# секрет для SearXNG (docker compose)
SEARXNG_SECRET=tgnews_searxng_change_me
