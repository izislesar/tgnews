# opencode go: ключ из ~/.pi/agent/auth.json на локалке (поле key вида oc_sk_...)
OPENCODE_API_KEY=oc_sk_xxxxxxxxxxxxxxxxxxxxxxxx
OPENCODE_MODEL=muse-spark-1.3-contributor
OPENCODE_MODEL_FALLBACK=glm-5.3-flash

# Куда сыпать черновики:
#   @username  — бот из BotFather / публичный канал
#   -100XXXXXX — числовой ID закрытой группы (узнаёшь при первом bootstrap.py:
#                там печатается список твоих групп с ID)
#   me         — Saved Messages
DRAFT_TARGET=@lalsdjasdljkbot

# (необязательно) — если пусто, юзербот притворяется Telegram Desktop
# API_ID=12345678
# API_HASH=xxxx....

SESSION_PATH=/data/session
RATE_SECONDS=180
WINDOW_START=7
WINDOW_END=22
TZ=Europe/Berlin
